<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | <%= site.title %></title>
  <meta name="description" content="<%= site.description %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            border: 'hsl(214 32% 91%)',
            input: 'hsl(214 32% 91%)',
            ring: 'hsl(221 83% 53%)',
            background: 'hsl(210 40% 98%)',
            foreground: 'hsl(222 47% 11%)',
            primary: {
              DEFAULT: 'hsl(221 83% 53%)',
              foreground: 'hsl(210 40% 98%)',
            },
            secondary: {
              DEFAULT: 'hsl(214 32% 91%)',
              foreground: 'hsl(222 47% 11%)',
            },
            muted: {
              DEFAULT: 'hsl(210 40% 96%)',
              foreground: 'hsl(215 16% 47%)',
            },
            accent: {
              DEFAULT: 'hsl(217 91% 60%)',
              foreground: 'hsl(210 40% 98%)',
            },
            card: {
              DEFAULT: 'hsl(0 0% 100%)',
              foreground: 'hsl(222 47% 11%)',
            },
            navy: {
              50: '#eff6ff',
              100: '#dbeafe',
              200: '#bfdbfe',
              300: '#93c5fd',
              400: '#60a5fa',
              500: '#3b82f6',
              600: '#2563eb',
              700: '#1d4ed8',
              800: '#1e3a8a',
              900: '#0f172a',
              950: '#020617',
            },
          },
          borderRadius: {
            lg: '0.5rem',
            md: '0.375rem',
            sm: '0.25rem',
          },
          boxShadow: {
            card: '0 1px 3px 0 rgb(0 0 0 / 0.08), 0 1px 2px -1px rgb(0 0 0 / 0.08)',
          },
          fontFamily: {
            sans: ['"IBM Plex Sans KR"', 'sans-serif'],
          },
          lineHeight: {
            relaxed: '1.85',
            loose: '1.95',
          },
        },
      },
    };
  </script>
  <link rel="stylesheet" href="/css/custom.css">
  <link rel="stylesheet" href="/css/document-content.css">
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
</head>
<body class="min-h-screen bg-background font-sans text-base leading-relaxed text-foreground antialiased">
