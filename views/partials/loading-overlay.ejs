  class="fixed inset-0 z-50 hidden items-center justify-center bg-navy-950/50 backdrop-blur-sm"
  aria-hidden="true"
  role="alertdialog"
  aria-live="polite"
  aria-label="로딩 중"
>
  <div class="rounded-lg border border-border bg-card px-8 py-6 text-center shadow-card">
