<footer class="border-t border-border bg-navy-900 text-slate-300">
  <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-4 text-sm leading-relaxed sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
    <div class="flex items-center gap-2">
      <i data-lucide="map-pin" class="h-3.5 w-3.5 shrink-0 text-navy-300"></i>
      <span><%= site.footer.address %></span>
    </div>
    <div class="flex items-center gap-2">
      <i data-lucide="phone" class="h-3.5 w-3.5 shrink-0 text-navy-300"></i>
      <span><%= site.footer.phone %></span>
    </div>
    <div class="flex items-center gap-2">
      <i data-lucide="copyright" class="h-3.5 w-3.5 shrink-0 text-navy-300"></i>
      <span><%= site.footer.copyright %></span>
    </div>
  </div>
</footer>
